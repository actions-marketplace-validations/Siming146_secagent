# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# GitHub Integration (Optional: required for automated PR creation)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPOSITORY=owner/repository_name

# Sandbox Execution Limits
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_RETRIES=3

# Output & Logging
SECAGENT_LOG_LEVEL=INFO
SECAGENT_SARIF_OUTPUT=results.sarif.json
